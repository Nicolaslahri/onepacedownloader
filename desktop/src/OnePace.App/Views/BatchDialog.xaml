<UserControl
    x:Class="OnePace.App.BatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="440">
    <StackPanel>
        <TextBlock x:Name="FromText" Style="{StaticResource SecondaryText}" Margin="0,0,0,16" />

        <StackPanel x:Name="VersionPanel">
            <TextBlock Style="{StaticResource BodyText}" Text="Version" Margin="0,0,0,6" />
            <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />
        </StackPanel>
        <TextBlock Style="{StaticResource BodyText}" Text="Quality" Margin="0,14,0,6" />
        <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />

        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowText}" Text="Total download size" />
                <TextBlock x:Name="SizeText" FontSize="32" FontWeight="SemiBold" Text="—"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="NotesText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                <CheckBox x:Name="AllowSubsBox" Margin="0,10,0,0" Content="Get the subtitled version of those instead"
                          Checked="OnChoiceChanged" Unchecked="OnChoiceChanged" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <CheckBox x:Name="SkipSavedBox" Margin="0,14,0,0" Checked="OnChoiceChanged" Unchecked="OnChoiceChanged" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
