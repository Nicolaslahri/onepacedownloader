<UserControl
    x:Class="OnePace.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:OnePace.App">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
            <Setter Property="Margin" Value="2,24,0,8" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="240" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,36" MaxWidth="1000">
            <TextBlock Style="{StaticResource TitleText}" Text="Settings" />

            <!-- Downloads -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Downloads" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Folder24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="Save folder" />
                        <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Text="{Binding SaveFolder}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Browse" Command="{Binding PickFolderCommand}" />
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.ClosedCaption24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="Default version" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Shown in the episode list and picked first when you download several episodes." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Versions}" SelectedItem="{Binding DefaultVersion}" />
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.VideoClip24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="Default quality" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="When an episode doesn't come in it, the best one there is gets picked." TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Qualities}" SelectedItem="{Binding DefaultQuality}" />
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.PersonVoice24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="Get the subtitled version when there's no dub" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="With this off, episodes that haven't been dubbed yet are skipped when you download dubs." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding AllowSubFallback}" />
            </ui:CardControl>

            <!-- Library -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Library" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Library24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="Organize for Plex and Jellyfin" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Files go into One Pace / Season N / One Pace - sNNeMM - Title, with episode details (.nfo) alongside, so your media server picks them up." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Organize}" />
            </ui:CardControl>

            <!-- Appearance -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.DarkTheme24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="App theme" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="System follows your Windows setting." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            </ui:CardControl>

            <!-- Network -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Network" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.GlobeShield24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="DNS switcher" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="If downloads never start, your internet provider may be blocking the download servers. Switching DNS gets around it." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Open" Command="{Binding DataContext.OpenDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </ui:CardControl>

            <ui:CardExpander x:Name="UsenetCard" Margin="0,0,0,4">
                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.Server24}" /></ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="Usenet indexer" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="Only needed for the Usenet source. The release IDs are NZBGeek's, so you need an NZBGeek API key. It stays in config.json on this PC." />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="40,0,0,0">
                    <TextBlock Style="{StaticResource BodyText}" Text="Indexer URL" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding UsenetUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://api.nzbgeek.info" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360" />
                    <TextBlock Style="{StaticResource BodyText}" Text="API key" Margin="0,12,0,4" />
                    <ui:PasswordBox x:Name="ApiKeyBox" PlaceholderText="Paste your indexer API key" MaxWidth="520" MinWidth="360"
                                    HorizontalAlignment="Left" PasswordChanged="OnApiKeyChanged" />
                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button Content="Get my API key" Margin="0,0,8,0"
                                   Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="https://nzbgeek.info/dashboard.php?myaccount" />
                        <ui:Button Content="Setup guide" Margin="0,0,8,0"
                                   Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="https://github.com/Nicolaslahri/onepacedownloader#usenet-setup" />
                        <ui:Button Content="Test connection" Appearance="Primary" Command="{Binding TestUsenetCommand}" />
                    </WrapPanel>
                    <TextBlock x:Name="TestResultText" Margin="0,10,0,0" Text="{Binding TestResult}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestOk}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Testing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:CardExpander>

            <!-- Catalog -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Episode catalog" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="{x:Static ui:SymbolRegular.ArrowSync24}" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding CatalogBuilt}" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="{Binding LastRefresh}" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="The catalog is rebuilt on GitHub every week. Refresh grabs the newest one in a couple of seconds." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Re-download" Margin="0,0,8,0" Command="{Binding RedownloadCatalogCommand}"
                               ToolTip="Fetch the whole catalog again, even if it looks current" />
                    <ui:Button Content="Check now" Appearance="Primary"
                               Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </ui:CardControl>

            <!-- About -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:ImageIcon Source="pack://application:,,,/Assets/icon.png" Width="24" Height="24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" Text="One Pace Downloader" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding AppVersion, StringFormat=Version {0}  ·  Made by Nicolas  ·  MIT licensed}" />
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Text="A downloader for the One Pace fan re-cut of One Piece. Not affiliated with One Pace, Toei or Shueisha." />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BrandButton}" Background="#5865F2" Content="Discord"
                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="https://discord.gg/KHn6AbevZ2" />
                    <Button Style="{StaticResource BrandButton}" Background="#FF4500" Content="Reddit"
                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="https://www.reddit.com/user/nicolasenjah/" />
                    <Button Style="{StaticResource BrandButton}" Background="#33383F" Content="GitHub" Margin="0"
                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="https://github.com/Nicolaslahri/onepacedownloader" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
